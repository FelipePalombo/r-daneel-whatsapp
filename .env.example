# Telefones permitidos são configurados em allowed-numbers.json.
AUTH_DIR=./data/auth
# QR de vinculação aparece somente com esta opção e terminal interativo.
PAIRING_MODE=false
# Opcional: caminho absoluto do executável yt-dlp.
# YT_DLP_PATH=/caminho/yt-dlp

# Cobalt local usado somente se yt-dlp falhar.
COBALT_API_URL=http://127.0.0.1:9000/

# Terceira tentativa para Instagram: Snapinsta (compartilha a URL pública com o serviço).
# Defina false para desativar; o padrão é true.
SNAPINSTA_ENABLED=true

# Contingências públicas de Twitter/X; ambas habilitadas por padrão.
FXTWITTER_ENABLED=true
VXTWITTER_ENABLED=true
